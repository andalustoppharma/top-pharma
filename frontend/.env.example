# ═══════════════════════════════════════════════
# Pharma System — Frontend Environment Variables
# انسخ هذا الملف إلى `.env` وعدّل القيم
# ═══════════════════════════════════════════════

# ─── Backend API ───
# للتطوير المحلي: استخدم /api إذا كان لديك proxy في vite.config.js
# أو استخدم الرابط الكامل:
VITE_API_URL=http://localhost:5000/api

# ─── Session ───
# مدة الخمول قبل تسجيل الخروج التلقائي (بالدقائق)
VITE_SESSION_IDLE_TIMEOUT=30

# ─── App Info ───
VITE_APP_NAME=Pharma System
VITE_APP_VERSION=2.0.0